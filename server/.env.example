# Daily Affirm API Server — Environment Variables

# Server port (default: 3001)
PORT=3001

# Environment (development | production)
NODE_ENV=production

# Path to SQLite database file (default: ./data/daily-affirm.db)
# For containerized deployment, use a persistent volume path
DB_PATH=/data/daily-affirm.db

# Allowed CORS origins (comma-separated)
# In production, set to your frontend URLs
# For Capacitor iOS app: the app uses file:// so use "*" or your domain
CORS_ORIGINS=*

# Optional: Push notification service config (for future use)
# FCM_SERVER_KEY=